{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS": "true"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS": "false",
        "EXPO_PUBLIC_BACKEND_MODE": "supabase"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
