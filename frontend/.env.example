# Public build-time configuration. Populate these in EAS Secrets / CI, never
# commit a production .env file containing credentials.
EXPO_PUBLIC_BACKEND_URL=https://api.example.com
EXPO_PUBLIC_ROUTING_BASE_URL=https://routing.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_PRIVACY_CONTACT=privacy@example.com
# Preview/testing only. Do not set this in a public App Store/Google Play build.
EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS=false
