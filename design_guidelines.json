{
  "theme": "dark",
  "archetype": "5 (Jewel & Luxury)",
  "brand_identity": {
    "name": "VIP KIDS TRANSPORTATION",
    "description": "Premium mobile application for a private school chauffeur company based in Hollywood, Florida, providing luxury school transportation for children using only sedans and SUVs.",
    "emotional_tone": "Premium, safe, minimal, elegant, professional, and trusted.",
    "anti_patterns": [
      "No rideshare aesthetics (Uber/Lyft clones)",
      "No cartoon UI, overly playful design, or childish motifs",
      "No bright neons or generic primary tech blue",
      "No school buses or vans in imagery"
    ]
  },
  "typography": {
    "primary_font": "Playfair Display",
    "secondary_font": "Outfit",
    "font_loading_instructions": "Use @expo-google-fonts/playfair-display and @expo-google-fonts/outfit.",
    "scales": {
      "h1": { "fontSize": 36, "fontFamily": "PlayfairDisplay_600SemiBold", "lineHeight": 44, "letterSpacing": 0.5 },
      "h2": { "fontSize": 28, "fontFamily": "PlayfairDisplay_600SemiBold", "lineHeight": 36, "letterSpacing": 0.5 },
      "h3": { "fontSize": 22, "fontFamily": "PlayfairDisplay_500Medium", "lineHeight": 30, "letterSpacing": 0.25 },
      "body_large": { "fontSize": 18, "fontFamily": "Outfit_400Regular", "lineHeight": 26 },
      "body": { "fontSize": 16, "fontFamily": "Outfit_400Regular", "lineHeight": 24 },
      "body_small": { "fontSize": 14, "fontFamily": "Outfit_400Regular", "lineHeight": 20 },
      "caption": { "fontSize": 12, "fontFamily": "Outfit_500Medium", "lineHeight": 16, "letterSpacing": 0.5, "textTransform": "uppercase" }
    }
  },
  "colors": {
    "background": {
      "primary": "#09090B",
      "secondary": "#18181B",
