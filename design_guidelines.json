        "padding": 16,
        "color": "#FAFAFA",
        "fontFamily": "Outfit_400Regular",
        "fontSize": 16
      }
    },
    "bottom_tab_bar": {
      "backgroundColor": "#18181B",
      "borderTopWidth": 1,
      "borderTopColor": "#27272A",
